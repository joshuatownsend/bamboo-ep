{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the BambooHR training exporter",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "opener:allow-open-path",
    "store:default",
    "dialog:allow-open",
    "dialog:allow-message",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://*.bamboohr.com/*" },
        { "url": "https://api.bamboohr.com/*" }
      ]
    }
  ]
}
